snippet c "\cite{...}"
\cite{$0}
endsnippet

snippet pc "\parencite{...}"
\parencite{$0}
endsnippet

snippet em "\emph{...}"
\emph{$0}
endsnippet

snippet emq "\emquote{...}"
\emquote{$0}
endsnippet

snippet tq "\textquote{...}"
\textquote{$0}
endsnippet

snippet v "\verb|...|"
\verb|$0|
endsnippet

snippet v+ "\verb#...#"
\verb#$0#
endsnippet
